pipeline {
    agent any
    stages {
        stage('Copy files to ansible server') {
            steps {
                
                script {
                    echo "Copying files to ansible server"
                    sshagent(['ansible-server-key']) {
                        sh "scp -o StrictHostKeyChecking=no projects/Jenkins-Ansible/ansible/* root@159.89.54.64:/root" //Replace with your ansible server IP address

                        withCredentials([sshUserPrivateKey(credentialsId: 'ec2-server-key', keyFileVariable: 'keyFile', usernameVariable: 'SSH_USER')]) {
                            sh 'scp $keyFile root@159.89.54.64:/root/ssh-key.pem' //Replace with your ansible server IP address
                        }
                    }                  
                
                }
            }
        }
        stage('Execute Ansible Playbook') {
            steps {
                script {
                    echo "Executing Ansible Playbook to configure EC2 Instances"
                    def remote = [:]
                    remote.name = 'ansible-server'
                    remote.host = '159.89.54.64' //Replace with your ansible server IP address
                    remote.allowAnyHosts = true
                    withCredentials([sshUserPrivateKey(credentialsId: 'ansible-server-key', keyFileVariable: 'keyFile', usernameVariable: 'SSH_USER')]) {
                        remote.user = SSH_USER
                        remote.identityFile = keyFile
                        sshCommand remote: remote, command: "ls -l /root" //Replace with your ansible server IP address
                    }
                    
                }    
            }        
        }            
    }
}     
        
        
        
        
        
        
    
